{
  "name": "mimikkai-editor-pack",
  "displayName": "MimikkAI Editor Extension Pack",
  "description": "Installs the MimikkAI extension set from the marketplace on startup.",
  "version": "1.1.0",
  "publisher": "MimikkAi",
  "license": "MIT",
  "engines": {
    "vscode": "^1.135.0"
  },
  "categories": [
    "Extension Packs"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "capabilities": {
    "virtualWorkspaces": {
      "supported": true
    },
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "mimikkai.pack.install",
        "title": "MimikkAI: Install Extension Pack"
      }
    ]
  }
}
